{
  "manifest_version": 3,
  "name": "提示词",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "description": "个人提示词库：分类、置顶、搜索、一键复制，数据仅保存在本地浏览器。",
  "permissions": ["storage", "sidePanel", "clipboardWrite"],
  "action": {
    "default_title": "提示词",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      }
    }
  }
}
